# Copie para .env e ajuste. Não versione o .env.
# Formato KEY=VALUE, sem `export`. Variáveis já definidas no shell têm prioridade.

# Obrigatório: pasta do vault Obsidian (copie vault-template/ para começar).
GV_VAULT=~/gravador-vault-notas

# Staging dos áudios. Padrão: RECORD/ na raiz deste repositório (ignorado pelo git).
# GV_RECORD=~/gravador-vault/RECORD

# Cache local (índice de embeddings, propostas, checkpoints). Padrão: .cache/
# GV_CACHE=~/gravador-vault/.cache

# Taxonomia e prompts. Padrão: config/categorias.yaml
# GV_CATEGORIAS=~/minhas-categorias.yaml

# Transcrição (Faster-Whisper)
GV_IDIOMA=pt
GV_STT_DEVICE=cpu          # cuda se tiver GPU NVIDIA com CUDA configurado
GV_STT_COMPUTE=int8        # float16 com GPU
GV_STT_MODELO=medium       # padrão do prompt interativo

# Cache de modelos Whisper (Hugging Face). Útil para apontar a um disco maior.
# HF_HOME=~/.cache/huggingface

# LLM local (Ollama). O daemon precisa estar rodando: `ollama serve`.
GV_OLLAMA_URL=http://127.0.0.1:11434
GV_LLM_MODEL=qwen3.5:9b
GV_EMBED_MODEL=bge-m3:latest

# Fonte do LLM em enriquecer.py: ollama (padrão), gemini (CLI autenticado) ou auto.
GV_LLM_FONTE=ollama
